FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neon.tech/neondb/auth
# Optional: defaults to NEON_AUTH_BASE_URL + /.well-known/jwks.json.
# Any override must match the same endpoint and branch.
NEON_AUTH_JWKS_URL=https://your-auth-endpoint.neon.tech/neondb/auth/.well-known/jwks.json
# Defaults: issuer and audience = NEON_AUTH_BASE_URL's origin (without path).
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=
SPACY_MODEL=en_core_web_md
